// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  cnpj      String?   @unique
  phone     String?
  email     String?
  address   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id               String     @id @default(uuid())
  name             String
  barcode          String?    @unique
  barcodeGenerated Boolean    @default(false)
  description      String?
  price            Decimal    @db.Decimal(10, 2)
  costPrice        Decimal    @db.Decimal(10, 2)
  categoryId       String
  brandId          String
  supplierId       String?
  imageUrl         String?
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  category  Category      @relation(fields: [categoryId], references: [id])
  brand     Brand         @relation(fields: [brandId], references: [id])
  supplier  Supplier?     @relation(fields: [supplierId], references: [id])
  stock     Stock?
  saleItems SaleItem[]
  colors    ProductColor[]
}

model ProductColor {
  id         String   @id @default(uuid())
  productId  String
  name       String
  colorCode  String?
  imageUrl   String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Stock {
  id          String   @id @default(uuid())
  productId   String   @unique
  quantity    Int      @default(0)
  minQuantity Int      @default(5)
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model PaymentMethod {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  salePayments SalePaymentMethod[]
}

model Sale {
  id         String   @id @default(uuid())
  total      Decimal  @db.Decimal(10, 2)
  discount   Decimal  @db.Decimal(10, 2) @default(0)
  finalTotal Decimal  @db.Decimal(10, 2)
  amountPaid Decimal  @db.Decimal(10, 2)
  change     Decimal  @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now())

  payments SalePaymentMethod[]
  items    SaleItem[]
}

model SalePaymentMethod {
  id               String   @id @default(uuid())
  saleId           String
  paymentMethodId  String
  amount           Decimal  @db.Decimal(10, 2)
  installments     Int?
  installmentValue Decimal? @db.Decimal(10, 2)

  sale          Sale          @relation(fields: [saleId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model CashRegister {
  id             String              @id @default(uuid())
  openedAt       DateTime            @default(now())
  closedAt       DateTime?
  initialAmount  Decimal             @db.Decimal(10, 2)
  finalAmount    Decimal?            @db.Decimal(10, 2)
  expectedAmount Decimal?            @db.Decimal(10, 2)
  difference     Decimal?            @db.Decimal(10, 2)
  status         CashRegisterStatus  @default(OPEN)
  notes          String?
  closingNotes   String?

  bleeds CashBleed[]
}

model CashBleed {
  id             String       @id @default(uuid())
  cashRegisterId String
  amount         Decimal      @db.Decimal(10, 2)
  reason         String
  createdAt      DateTime     @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
}
